# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# The EXPO_PUBLIC_ prefix is required — Expo only inlines env vars with this
# prefix into the app bundle. The anon key is safe to ship in the app; every
# table it can touch is protected by the row-level security policies in
# supabase/migrations/0001_init.sql.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
