# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# The EXPO_PUBLIC_ prefix is required — Expo only inlines env vars with this
# prefix into the app bundle. The anon key is safe to ship in the app; every
# table it can touch is protected by the row-level security policies in
# supabase/migrations/0001_init.sql.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat Project Settings → API keys → Test Store API key.
# Test Store purchases exercise the RevenueCat sandbox flow during development.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Release builds use the matching platform-specific RevenueCat public SDK key.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
